# Required only for the Vercel Web TAPAS AI serverless endpoint.
GROQ_API_KEY=your_groq_api_key_here
# Optional; defaults to openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b

# Desktop app only (optional): address of your deployed endpoint, so the INSTALLED app can use TAPAS AI
# without any API key inside it. Set as an environment variable when running, or as the GitHub
# Actions secret TAPAS_AI_URL when building releases.
# TAPAS_AI_URL=https://your-project.vercel.app/api/tapas-ai
